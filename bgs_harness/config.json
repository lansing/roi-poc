{
  "stream": {
    "codec": "h264",
    "bitrate_kbps": 1000,
    "width": 1280,
    "height": 720,
    "fps": 5
  },
  "algorithms": [
    "MixtureOfGaussianV2",
    "OpenCVMOG2",
    "OpenCVMOG2_noshadow",
    "FrigateImprovedMotion"
  ],
  "frigate": {
    "threshold": 30,
    "contour_area": 100,
    "frame_alpha": 0.01,
    "delta_alpha": 0.2,
    "improve_contrast": true,
    "frame_height": null,
    "lightning_threshold": 0.8
  },
  "downscale_width": 720,
  "max_frames": 0,
  "morphology": {
    "enabled": true,
    "kernel_size": 3,
    "iterations": 3
  },
  "contours": {
    "min_area": 200,
    "max_area_ratio": 0.9
  },
  "frigate_preproc": {
    "enabled": false,
    "gaussian_blur": false,
    "gaussian_sigma": 1.0,
    "gaussian_ksize": 3,
    "contrast_norm": true,
    "contrast_history": 50,
    "contrast_min_pct": 4.0,
    "contrast_max_pct": 96.0,
    "persistence_frames": 2
  }
}
